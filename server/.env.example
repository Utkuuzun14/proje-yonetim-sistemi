PORT=5000
DATABASE_URL=postgresql://admin:password@localhost:5433/sektech
JWT_SECRET=dev-jwt-secret-key-sektech-2026
JWT_EXPIRES_IN=8h
CORS_ORIGIN=*
BCRYPT_ROUNDS=12
# Giriş deneme sınırı (SRS 4.2): 15 dk'da 5 başarısız deneme
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX_FAILURES=5
# Ters vekil (nginx vb.) arkasında gerçek IP için true
TRUST_PROXY=false

# Testler bu ayrı veri tabanını kullanır (yoksa otomatik oluşturulur, her koşuda init + seed yüklenir)
TEST_DATABASE_URL=postgresql://admin:password@localhost:5433/sektech_test
